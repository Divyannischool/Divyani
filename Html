<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CreatorHub</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #090d0e;
      color: white;
    }

    /* Navbar */
    nav {
      height: 88px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5%;
      border-bottom: 1px solid #292d2e;
    }

    .logo {
      font-size: 42px;
      font-weight: 800;
      color: #ffaaa3;
    }

    .nav-links {
      display: flex;
      gap: 45px;
    }

    .nav-links a {
      color: #d9c0bd;
      text-decoration: none;
      font-size: 17px;
    }

    .nav-links a:hover {
      color: #ffaaa3;
    }

    .subscribe {
      background: #ffaaa3;
      color: #351b1b;
      padding: 14px 30px;
      border-radius: 30px;
      font-size: 18px;
      font-weight: bold;
      text-decoration: none;
    }

    /* Main */
    .container {
      padding: 60px 5%;
    }

    .heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    h1 {
      font-size: 68px;
      margin-bottom: 15px;
    }

    .intro {
      color: #d8b8b5;
      font-size: 18px;
      line-height: 1.5;
    }

    .search {
      background: #1a1a1a;
      border: 1px solid #393333;
      border-radius: 35px;
      padding: 17px 25px;
      color: white;
      width: 410px;
      font-size: 16px;
    }

    /* Categories */
    .categories {
      display: flex;
      gap: 15px;
      margin: 50px 0;
    }

    .category {
      background: #171919;
      border: 1px solid #252828;
      color: white;
      padding: 12px 27px;
      border-radius: 30px;
      cursor: pointer;
    }

    .category.active {
      border-color: #ffaaa3;
      color: #ffaaa3;
    }

    /* Videos */
    .videos {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }

    .card {
      overflow: hidden;
    }

    .thumbnail {
      height: 175px;
      border-radius: 25px;
      background: linear-gradient(135deg, #351b46, #122d4c, #202020);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
    }

    .thumbnail:nth-child(1) {
      background: linear-gradient(135deg, #241226, #321f48);
    }

    .duration {
      position: absolute;
      bottom: 10px;
      right: 10px;
      background: #050505;
      padding: 5px 8px;
      border-radius: 4px;
      font-size: 13px;
    }

    .live {
      position: absolute;
      top: 12px;
      left: 12px;
      background: #ffaaa3;
      color: #291515;
      padding: 6px 10px;
      border-radius: 5px;
      font-weight: bold;
      font-size: 12px;
    }

    .card h2 {
      font-size: 21px;
      line-height: 1.3;
      margin: 18px 5px 8px;
    }

    .card p {
      color: #d5aaa7;
      margin-left: 5px;
      font-size: 14px;
    }

    /* Load more */
    .load {
      display: block;
      margin: 70px auto 20px;
      padding: 17px 45px;
      background: #191b1b;
      border: 1px solid #303333;
      color: white;
      border-radius: 35px;
      font-size: 17px;
      cursor: pointer;
    }

    /* Footer */
    footer {
      background: #292a2b;
      padding: 55px 5%;
      margin-top: 20px;
      display: flex;
      justify-content: space-between;
    }

    footer h2 {
      font-size: 32px;
      margin-bottom: 20px;
    }

    footer p {
      color: #c5aaa8;
      line-height: 1.6;
    }

    .connect {
      font-size: 22px;
    }

    /* Mobile */
    @media (max-width: 900px) {
      .nav-links {
        display: none;
      }

      .heading {
        flex-direction: column;
        align-items: flex-start;
        gap: 25px;
      }

      .search {
        width: 100%;
      }

      .videos {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .logo {
        font-size: 30px;
      }

      .subscribe {
        padding: 10px 18px;
        font-size: 14px;
      }

      h1 {
        font-size: 45px;
      }

      .videos {
        grid-template-columns: 1fr;
      }

      .categories {
        overflow-x: auto;
      }

      footer {
        flex-direction: column;
        gap: 30px;
      }
    }
  </style>
</head>

<body>

  <nav>
    <div class="logo">CreatorHub</div>

    <div class="nav-links">
      <a href="#">Home</a>
      <a href="#">About</a>
      <a href="#">Videos</a>
      <a href="#">Shorts</a>
      <a href="#">Gallery</a>
      <a href="#">Contact</a>
      <a href="#">Support</a>
    </div>

    <a href="#" class="subscribe">Subscribe</a>
  </nav>

  <main class="container">

    <div class="heading">
      <div>
        <h1>Video Vault</h1>
        <p class="intro">
          Dive into the latest masterclasses, behind-the-scenes vlogs,
          and high-energy streams.<br>
          The cinematic experience starts here.
        </p>
      </div>

      <input class="search" type="text" placeholder="🔍  Search videos...">
    </div>

    <div class="categories">
      <button class="category active">All</button>
      <button class="category">Latest</button>
      <button class="category">Popular</button>
      <button class="category">Tutorials</button>
      <button class="category">Vlogs</button>
    </div>

    <section class="videos">

      <div class="card">
        <div class="thumbnail">
          🎥
          <span class="live">LIVE</span>
          <span class="duration">14:20</span>
        </div>
        <h2>Mastering Cinematic Lighting in Small Studios</h2>
        <p>Oct 24, 2024 • 120K views</p>
      </div>

      <div class="card">
        <div class="thumbnail">
          🌃
          <span class="duration">08:45</span>
        </div>
        <h2>Tokyo Drift: Midnight Photography Walk</h2>
        <p>Oct 20, 2024 • 85K views</p>
      </div>

      <div class="card">
        <div class="thumbnail">
          💻
          <span class="duration">22:10</span>
        </div>
        <h2>Understanding WebGL: Visualizing Audio</h2>
        <p>Oct 18, 2024 • 42K views</p>
      </div>

      <div class="card">
        <div class="thumbnail">
          🖥️
          <span class="duration">10:05</span>
        </div>
        <h2>Desk Setup Tour 2024: The Ultimate Creator Workspace</h2>
        <p>Oct 15, 2024 • 210K views</p>
      </div>

    </section>

    <button class="load">Load More　⌄</button>

  </main>

  <footer>
    <div>
      <h2>CreatorHub</h2>
      <p>© 2024 CreatorHub. All rights reserved.</p>
    </div>

    <div>
      <p>Sitemap</p>
      <p>Privacy Policy</p>
      <p>Terms of Service</p>
      <p>Newsletter</p>
    </div>

    <div class="connect">
      <strong>Connect</strong>
      <p>↗　✉</p>
    </div>
  </footer>

</body>
</html>
